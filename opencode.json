{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md"
  ],
  "agent": {
    "build": {
      "prompt": "{file:./prompts/minimal.txt}"
    },
    "plan": {
      "prompt": "{file:./prompts/minimal.txt}"
    }
  },"compaction": {
    "auto": true,
    "prune": false,
    "preserve_recent_tokens": 20000,
    "reserved": 8000
  },
  "permission": "allow",
  "disabled_providers": [],
  "provider": {
    "lmstudio-qwen": {
      "name": "LM Studio (Qwen Models)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://192.168.0.246:1234/v1",
        "apiKey": "local-key",
        "timeout": 6000000,
        "chunkTimeout": 6000000,
        "headers": {
          "Content-Type": "application/json"
        }
      },
      "models": {
        "qwen3.5-4b-claude-4.6-opus-reasoning-distilled-v2": {
          "name": "qwen3.5-4b-claude-4.6-opus-reasoning-distilled-v2",
          "limit": {
            "context": 96000,
            "output": 16000
          },
          "options": {
            "temperature": 0.6,
            "topP": 0.95,
            "stopSequences": [],
            "extraBody": {
              "top_k": 20,
              "min_p": 0.05,
              "repeat_penalty": 1.05
            }
          }
        },
      }
    },
    "lmstudio-gemma": {
      "name": "LM Studio (Gemma Models)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://192.168.0.246:1234/v1",
        "apiKey": "local-key",
        "timeout": 6000000,
        "chunkTimeout": 6000000,
        "headers": {
          "Content-Type": "application/json"
        }
      },
      "models": {}
    },
    "lmstudio-other": {
      "name": "LM Studio (Other Models)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://192.168.0.246:1234/v1",
        "apiKey": "local-key",
        "timeout": 6000000,
        "chunkTimeout": 6000000,
        "headers": {
          "Content-Type": "application/json"
        }
      },
      "models": {
        "empero-ai/Qwythos-9B-Claude-Mythos-5-1M-GGUF": {
          "name": "empero-ai/Qwythos-9B-Claude-Mythos-5-1M-GGUF",
          "limit": {
            "context": 80000,
            "output": 24000
          },
          "options": {
            "temperature": 0.6,
            "topP": 0.95,
            "stopSequences": [],
            "extraBody": {
              "top_k": 20,
              "min_p": 0.05,
              "repeat_penalty": 1.05
            }
          }
        },
        "bonsai-27b-q1-0-gguf": {
          "name": "bonsai-27b-q1-0-gguf",
          "limit": {
            "context": 72000,
            "output": 8196
          }
        },
      }
    }
  }
}